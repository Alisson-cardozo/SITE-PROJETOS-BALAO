APP_NAME=Alisson Projetos
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
# URL do site (frontend) pro usuario final acessar - usado no botao/link dos
# emails enviados pro cliente. Deixe vazio ate ter o dominio definitivo.
FRONTEND_URL=
# Chave de criptografia (gerar uma vez com: php -r "echo base64_encode(random_bytes(32));")
APP_KEY=

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plotter_novo
DB_USERNAME=root
DB_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Fallback: se a OpenAI falhar, o sistema tenta de novo via Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Alisson Projetos
